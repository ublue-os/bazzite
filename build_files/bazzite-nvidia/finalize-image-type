#!/usr/bin/env bash
#
# Cleanup and finalize the NVIDIA configuration.
#
# Appends the Bazzite NVIDIA justfile include, handles dconf overrides for
# Silverblue, configures systemd services, and rebuilds the initramfs.
#
set -euo pipefail

echo "::group::Finalize bazzite-nvidia image"
trap 'echo "::endgroup::"' EXIT

# -- 1. Append Bazzite NVIDIA justfile include --
# Register the NVIDIA-specific just recipes in the global justfile.
echo "==> Appending Bazzite NVIDIA justfile include..."
echo 'import "/usr/share/ublue-os/just/95-bazzite-nvidia.just"' >> /usr/share/ublue-os/justfile

# -- 2. Handle Silverblue dconf overrides --
# On Silverblue-based images, copy and convert gschema overrides to dconf
# format, then remove the original gschema override files.
if grep -q "silverblue" <<< "${BASE_IMAGE_NAME}"; then
    echo "    Preparing Silverblue dconf overrides..."
    mkdir -p "/usr/share/ublue-os/dconfs/nvidia-silverblue/"

    echo "    Copying gschema overrides..."
    cp "/usr/share/glib-2.0/schemas/zz0-"*"-bazzite-nvidia-silverblue-"*".gschema.override" \
        "/usr/share/ublue-os/dconfs/nvidia-silverblue/"

    echo "    Converting gschema overrides to dconf..."
    dconf-override-converter to-dconf \
        "/usr/share/ublue-os/dconfs/nvidia-silverblue/zz0-"*"-bazzite-nvidia-silverblue-"*".gschema.override"

    echo "    Removing gschema override files..."
    rm "/usr/share/ublue-os/dconfs/nvidia-silverblue/zz0-"*"-bazzite-nvidia-silverblue-"*".gschema.override"
fi

# -- 3. Remove nvidia_peermem from dracut config --
# nvidia_peermem is not needed and can cause issues during initramfs generation.
echo "==> Removing nvidia_peermem from dracut config..."
sed -i \
    's/ nvidia_peermem\b//' \
    /usr/lib/dracut/dracut.conf.d/99-nvidia.conf

# -- 4. Configure NVIDIA systemd services --
# Enable power management and flatpak sync services; disable persistence
# service which is not required for most use cases.
echo "==> Configuring NVIDIA systemd services..."
systemctl enable nvidia-powerd.service
systemctl disable nvidia-persistenced.service
systemctl enable ublue-nvidia-flatpak-runtime-sync
systemctl enable ublue-nvidia-flatpak-runtime-verify

# -- 5. Re-enable skip_if_unavailable --
# Restore the default DNF behavior after all NVIDIA configuration is complete.
echo "==> Re-enabling skip_if_unavailable..."
dnf5 config-manager setopt skip_if_unavailable=1

# -- 6. Copy nvidia-modeset.conf if present --
# Ensure the modeset configuration is available in /usr/lib/modprobe.d
# for early kernel module loading.
if [[ -f "/etc/modprobe.d/nvidia-modeset.conf" ]]; then
    echo "    Copying nvidia-modeset.conf to /usr/lib/modprobe.d..."
    cp /etc/modprobe.d/nvidia-modeset.conf /usr/lib/modprobe.d/nvidia-modeset.conf
fi
