#!/usr/bin/env bash
#
# Remove packages globally across all Bazzite variants.
#
# This script removes packages that are replaced by flatpaks or
# alternative tools on all Bazzite images.
#
set -xeuo pipefail

echo "::group::Globally remove packages"
trap 'echo "::endgroup::"' EXIT

# -- 1. Define packages to remove --
# Packages to remove globally across all Bazzite variants.
# Not quoted in the array so brace expansion and multiple words expand
# correctly into individual dnf arguments.
declare -a REMOVE_GLOBAL=(
    firefox{,-langpacks}      # we use the flatpak
    htop                      # btop is better
    ublue-os-update-services  # we use uupd, from ublue-os/main
)

# Packages to remove on KDE (Kinoite).
declare -a REMOVE_KDE=()

# Packages to remove on GNOME (Silverblue).
declare -a REMOVE_GNOME=(
    toolbox  # can be a global removal after KDE Gear 26.08 landed
             # https://invent.kde.org/utilities/konsole/-/merge_requests/1207
)

# -- 2. Build the removal list based on the base image --
echo "==> Building removal list for '${BASE_IMAGE_NAME}'..."

if [[ "${BASE_IMAGE_NAME}" == "kinoite" ]]; then
    REMOVE_ALL=( "${REMOVE_KDE[@]}" "${REMOVE_GLOBAL[@]}" )
elif [[ "${BASE_IMAGE_NAME}" == "silverblue" ]]; then
    REMOVE_ALL=( "${REMOVE_GNOME[@]}" "${REMOVE_GLOBAL[@]}" )
fi

# -- 3. Remove the packages --
echo "==> Removing packages with dnf5..."
dnf5 -y remove "${REMOVE_ALL[@]}"
