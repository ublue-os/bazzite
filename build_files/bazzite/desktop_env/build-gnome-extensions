#!/usr/bin/env bash
#
# Build and compile GNOME shell extensions.
#
# Installs build dependencies, compiles extension schemas, builds extensions
# from source, downloads and installs the TouchUp extension from GitHub, and
# cleans up temporary files and build dependencies.
#
set -euo pipefail

# -- Install build dependencies --
# Install glib2-devel which provides glib-compile-schemas and build tooling.
echo "==> Installing build dependencies..."
dnf5 -y install glib2-devel

# -- Compile extension schemas --
# Compile GSettings schemas for all installed GNOME shell extensions.
echo "==> Compiling extension schemas..."
glib-compile-schemas /usr/share/gnome-shell/extensions/logomenu@aryan_k/schemas
glib-compile-schemas /usr/share/gnome-shell/extensions/compiz-windows-effect@hermes83.github.com/schemas
glib-compile-schemas /usr/share/gnome-shell/extensions/compiz-alike-magic-lamp-effect@hermes83.github.com/schemas
glib-compile-schemas /usr/share/gnome-shell/extensions/hotedge@jonathan.jdoda.ca/schemas
glib-compile-schemas /usr/share/gnome-shell/extensions/restartto@tiagoporsch.github.io/schemas
glib-compile-schemas /usr/share/gnome-shell/extensions/appindicatorsupport@rgcjonas.gmail.com/schemas
glib-compile-schemas /usr/share/gnome-shell/extensions/add-to-steam@pupper.space/schemas

# -- Install Caffeine extension --
# Move the extracted Caffeine extension to its final location and compile schemas.
echo "==> Installing Caffeine extension..."
mv /usr/share/gnome-shell/extensions/tmp/caffeine/caffeine@patapon.info \
    /usr/share/gnome-shell/extensions/caffeine@patapon.info
glib-compile-schemas /usr/share/gnome-shell/extensions/caffeine@patapon.info/schemas

# -- Build Burn My Windows --
# Build Burn My Windows from source, compile schemas, and remove the zip archive.
echo "==> Building Burn My Windows..."
make -C /usr/share/gnome-shell/extensions/burn-my-windows@schneegans.github.com
glib-compile-schemas /usr/share/gnome-shell/extensions/burn-my-windows@schneegans.github.com/schemas
rm /usr/share/gnome-shell/extensions/burn-my-windows@schneegans.github.com/burn-my-windows@schneegans.github.com.zip

# -- Build Desktop Cube --
# Build Desktop Cube from source, compile schemas, and remove the zip archive.
echo "==> Building Desktop Cube..."
make -C /usr/share/gnome-shell/extensions/desktop-cube@schneegans.github.com
glib-compile-schemas /usr/share/gnome-shell/extensions/desktop-cube@schneegans.github.com/schemas
rm /usr/share/gnome-shell/extensions/desktop-cube@schneegans.github.com/desktop-cube@schneegans.github.com.zip

# -- Build Blur My Shell --
# Build Blur My Shell from source, extract the zip bundle, compile schemas, and
# remove the build directory.
echo "==> Building Blur My Shell..."
make -C /usr/share/gnome-shell/extensions/blur-my-shell@aunetx
unzip -o /usr/share/gnome-shell/extensions/blur-my-shell@aunetx/build/blur-my-shell@aunetx.shell-extension.zip \
    -d /usr/share/gnome-shell/extensions/blur-my-shell@aunetx
glib-compile-schemas /usr/share/gnome-shell/extensions/blur-my-shell@aunetx/schemas
rm -rf /usr/share/gnome-shell/extensions/blur-my-shell@aunetx/build

# -- Install Bazaar Integration --
# Extract the Bazaar Integration extension from the tmp directory to its final
# location.
echo "==> Installing Bazaar Integration..."
mkdir -p /usr/share/gnome-shell/extensions/bazaar-integration@kolunmi.github.io
mv /usr/share/gnome-shell/extensions/tmp/bazaar-integration@kolunmi.github.io/src/* \
    /usr/share/gnome-shell/extensions/bazaar-integration@kolunmi.github.io/

# -- Install TouchUp extension --
# Download the latest TouchUp release from GitHub, extract it, compile schemas,
# and remove the downloaded archive.
echo "==> Installing TouchUp extension..."
TOUCHUP_DOWNLOAD_URL="$(/ctx/ghcurl https://api.github.com/repos/mityax/gnome-extension-touchup/releases/latest \
    | jq -r '.assets[] | select(.name | test(".*\\.shell-extension\\.zip$")).browser_download_url')"
/ctx/ghcurl "${TOUCHUP_DOWNLOAD_URL}" -Lo /tmp/touchup.zip
mkdir -p /usr/share/gnome-shell/extensions/touchup@mityax
unzip -o /tmp/touchup.zip -d /usr/share/gnome-shell/extensions/touchup@mityax
glib-compile-schemas /usr/share/gnome-shell/extensions/touchup@mityax/schemas
rm /tmp/touchup.zip

# -- Cleanup --
# Remove build dependencies and the temporary extensions directory.
echo "==> Cleaning up..."
dnf5 -y remove glib2-devel
rm -rf /usr/share/gnome-shell/extensions/tmp
