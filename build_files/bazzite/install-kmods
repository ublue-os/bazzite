#!/usr/bin/env bash
#
# Install kernel module RPMs passed as arguments.
#
# Each argument is a glob pattern that is resolved against the current
# directory.  Only existing files are installed; non-existent matches
# are skipped with a warning.
#
set -xeuo pipefail

# -- 1. Collect installable RPMs --
# Iterate over each argument (glob pattern), resolve it, and collect only
# files that actually exist on disk.
echo "==> Collecting RPMs to install..."

declare -a INSTALL_RPMS=()

for pattern in "$@"; do
    for rpm in $pattern; do
        if [[ -f "${rpm}" ]]; then
            INSTALL_RPMS+=("${rpm}")
        else
            echo "    SKIPPED: ${rpm}"
        fi
    done
done

# -- 2. Install collected RPMs --
# Use dnf to install all collected RPMs in one transaction.
echo "==> Installing ${#INSTALL_RPMS[@]} RPM(s)..."

if [[ ${#INSTALL_RPMS[@]} -gt 0 ]]; then
    dnf -y install "${INSTALL_RPMS[@]}"
else
    echo "WARNING: No kmod RPMs found"
fi
