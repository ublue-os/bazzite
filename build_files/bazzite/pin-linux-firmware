#!/usr/bin/env bash
#
# Pin linux-firmware to a known-good version specified by
# the LINUX_FIRMWARE_VERSION environment variable.
#
set -euo pipefail

echo "::group::Pin Linux firmware"
trap 'echo "::endgroup::"' EXIT

# -- 1. Install pinned firmware version --
# Install the exact linux-firmware package matching the pinned version.
echo "==> Installing pinned linux-firmware version: ${LINUX_FIRMWARE_VERSION}..."
dnf5 -y install \
    --best \
    --allowerasing \
    "linux-firmware-${LINUX_FIRMWARE_VERSION}*" \
    "linux-firmware-whence-${LINUX_FIRMWARE_VERSION}*"

# -- 2. Cleanup --
echo "==> Running cleanup..."
/ctx/cleanup
