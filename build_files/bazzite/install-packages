#!/usr/bin/env bash
#
# Install new packages, apply system configuration changes, and set up
# services for the Bazzite image.
#
set -euo pipefail

# ── 1. Install cicpoffs package from GitHub releases ───────────────────────
# Fetch the latest cicpoffs RPM for the current Fedora version.
echo "==> Installing cicpoffs package..."
cicpoffs_url=$(/ctx/ghcurl \
    https://api.github.com/repos/ublue-os/cicpoffs/releases/latest \
    | jq -r --arg name "cicpoffs-fc${FEDORA_VERSION}.rpm" \
        '.assets[] | select(.name == $name).browser_download_url')

dnf5 -y install "${cicpoffs_url}"
unset -v cicpoffs_url

# ── 2. Install SCX scheduler packages ──────────────────────────────────────
# Temporarily enable the kernel-cachyos-addons copr to install scx packages.
echo "==> Installing SCX scheduler packages..."
dnf5 -y copr enable bieszczaders/kernel-cachyos-addons
dnf5 -y install scx-scheds scx-tools
dnf5 -y copr disable bieszczaders/kernel-cachyos-addons

# ── 3. Install core packages ───────────────────────────────────────────────
# Install the main set of packages required for the Bazzite image.
echo "==> Installing core packages..."
dnf5 -y install \
    bpftune-gaming \
    fuse-libs \
    uld \
    bazaar \
    greenboot \
    greenboot-default-health-checks \
    ublue-os-selinux-workarounds \
    bazzite-updater \
    ScopeBuddy \
    twitter-twemoji-fonts \
    google-noto-sans-cjk-fonts \
    lato-fonts \
    fira-code-fonts \
    nerd-fonts \
    python3-pip \
    libadwaita \
    bees \
    xwininfo \
    usbip \
    compsize \
    ryzenadj \
    input-remapper \
    libinput-utils \
    i2c-tools \
    lm_sensors \
    iio-sensor-proxy \
    fw-ectool \
    fw-fanctrl \
    framework-system \
    udica \
    ladspa-caps-plugins \
    pipewire-module-filter-chain-sofa \
    python3-icoextract \
    tailscale \
    webapp-manager \
    btop \
    amdsmi \
    duf \
    fish \
    lshw \
    xdotool \
    wmctrl \
    libcec \
    linux-cec \
    inputattach-cec-units \
    linuxconsoletools \
    v4l-utils \
    yad \
    f3 \
    lzip \
    p7zip \
    p7zip-plugins \
    rar \
    libxcrypt-compat \
    vulkan-tools \
    vulkan-low-latency-layer \
    xwiimote-ng \
    fastfetch \
    glow \
    gum \
    vim \
    msedit \
    cockpit-networkmanager \
    cockpit-podman \
    cockpit-selinux \
    cockpit-system \
    cockpit-files \
    cockpit-storaged \
    ydotool \
    stress-ng \
    snapper \
    btrfs-assistant \
    edk2-ovmf \
    lsb_release \
    uupd \
    ds-inhibit \
    waydroid \
    cage \
    wlr-randr \
    gmodpatchtool \
    bazzite-portal \
    kernel-tools \
    ls-iommu

# ── 4. Replace switcheroo-control with cardwire ────────────────────────────
# Swap in cardwire (and its GUI) from the Terra repository.
echo "==> Installing cardwire from Terra repository..."
dnf5 -y swap \
    --repo terra \
    switcheroo-control cardwire

dnf5 -y install \
    --enable-repo=terra \
    cardwire-gui

# ── 5. Replace ddcutil packages with Terra variants ────────────────────────
# Swap in terra-ddcutil and terra-libddcutil from the Terra extras repository.
echo "==> Installing Terra ddcutil packages..."
dnf5 -y swap \
    --allowerasing \
    --repo terra-extras \
    ddcutil terra-ddcutil

dnf5 -y swap \
    --allowerasing \
    --repo terra-extras \
    libddcutil terra-libddcutil

# ── 6. Disable unnecessary services ────────────────────────────────────────
# Mask services that are not needed on the Bazzite image.
echo "==> Disabling unnecessary services..."
ln -s /dev/null /etc/NetworkManager/dispatcher.d/04-iscsi
systemctl mask iscsi
systemctl mask systemd-remount-fs.service
systemctl mask fedora-atomic-desktop-appstream-cache-refresh

# ── 7. Install extest library ──────────────────────────────────────────────
# Download the latest extest shared library and tag it as a Bazzite component.
echo "==> Installing extest library..."
mkdir -p /usr/lib/extest

extest_url=$(/ctx/ghcurl \
    https://api.github.com/repos/ublue-os/extest/releases/latest \
    | jq -r '.assets[] | select(.name| test(".*so$")).browser_download_url')

/ctx/ghcurl "${extest_url}" -Lo /usr/lib/extest/libextest.so
setfattr -n user.component -v "extest" /usr/lib/extest/libextest.so
unset -v extest_url

# ── 8. Install Sunshine postinst script ────────────────────────────────────
# Download and make executable the Sunshine post-installation script.
echo "==> Installing Sunshine postinst script..."
/ctx/ghcurl \
    "https://github.com/ykshek/Sunshine/raw/1347f9ef290c089b815cf186f7d361470bdb9ef7/src_assets/linux/misc/postinst" \
    -Lo /usr/libexec/sunshine-postinst

chmod +x /usr/libexec/sunshine-postinst

# ── 9. Create autostart directory ──────────────────────────────────────────
echo "==> Creating autostart directory..."
mkdir -p /etc/xdg/autostart

# ── 10. Apply system patches ───────────────────────────────────────────────
# Patch waydroid-network script and btrfs-assistant-launcher for compatibility.
echo "==> Applying system patches..."
sed -i~ -E 's/=.\$\(command -v (nft|ip6?tables-legacy).*/=/g' \
    /usr/lib/waydroid/data/scripts/waydroid-net.sh

sed -i 's/ --xdg-runtime=\\"${XDG_RUNTIME_DIR}\\"//g' \
    /usr/bin/btrfs-assistant-launcher

# ── 11. Cleanup ────────────────────────────────────────────────────────────
echo "==> Running cleanup..."
/ctx/cleanup
