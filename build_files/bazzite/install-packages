#!/usr/bin/env bash
#
# Install new packages, apply system configuration changes, and set up
# services for the Bazzite image.
#
set -xeuo pipefail

echo "::group::Install packages"
trap 'echo "::endgroup::"' EXIT

# -- Install Nerd Fonts --
echo "==> Installing Nerd Fonts..."
dnf5 -y install \
    --enable-repo=copr:copr.fedorainfracloud.org:che:nerd-fonts \
    nerd-fonts

# -- Install core packages --
# Install the main set of packages required for the Bazzite image.
echo "==> Installing core packages..."
dnf5 -y install \
    scx-scheds \
    scx-tools \
    bpftune-gaming \
    fuse-libs \
    uld \
    bazaar \
    greenboot \
    greenboot-default-health-checks \
    ublue-os-selinux-workarounds \
    bazzite-updater \
    ScopeBuddy \
    twitter-twemoji-fonts \
    google-noto-sans-cjk-fonts \
    lato-fonts \
    fira-code-fonts \
    python3-pip \
    libadwaita \
    bees \
    xwininfo \
    usbip \
    compsize \
    ryzenadj \
    input-remapper \
    libinput-utils \
    i2c-tools \
    lm_sensors \
    iio-sensor-proxy \
    fw-ectool \
    fw-fanctrl \
    framework-system \
    udica \
    ladspa-caps-plugins \
    pipewire-module-filter-chain-sofa \
    python3-icoextract \
    tailscale \
    webapp-manager \
    btop \
    amdsmi \
    duf \
    fish \
    lshw \
    xdotool \
    wmctrl \
    libcec \
    linux-cec \
    inputattach-cec-units \
    linuxconsoletools \
    v4l-utils \
    yad \
    f3 \
    lzip \
    p7zip \
    p7zip-plugins \
    rar \
    libxcrypt-compat \
    vulkan-tools \
    vulkan-low-latency-layer \
    game-devices-udev \
    openrgb-udev-rules \
    xwiimote-ng \
    fastfetch \
    glow \
    gum \
    vim \
    msedit \
    cockpit-networkmanager \
    cockpit-podman \
    cockpit-selinux \
    cockpit-system \
    cockpit-files \
    cockpit-storaged \
    ydotool \
    stress-ng \
    snapper \
    btrfs-assistant \
    btrfsmaintenance \
    edk2-ovmf \
    lsb_release \
    uupd \
    ds-inhibit \
    rocm-opencl \
    rocm-clinfo \
    rocm-smi \
    waydroid \
    cage \
    wlr-randr \
    bazzite-portal \
    kernel-tools \
    ls-iommu \
    sbsigntools \
    xdg-native-messaging-proxy \
    cicpoffs \
    openssl3-libs

# -- Replace switcheroo-control with cardwire --
# Swap in cardwire (and its GUI) from the Terra repository.
echo "==> Installing cardwire from Terra repository..."
dnf5 -y swap \
    --repo terra \
    switcheroo-control cardwire

dnf5 -y install \
    cardwire-gui

# -- Replace ddcutil packages with Terra variants --
# Install terra-ddcutil and terra-libddcutil from the Terra extras repository.
echo "==> Installing Terra ddcutil packages..."
dnf5 -y install \
    --allowerasing \
    --repo terra-extras \
    terra-ddcutil \
    terra-libddcutil

# -- Disable unnecessary services --
# Mask services that are not needed on the Bazzite image.
echo "==> Disabling unnecessary services..."
ln -s /dev/null /etc/NetworkManager/dispatcher.d/04-iscsi
systemctl mask iscsi
systemctl mask systemd-remount-fs.service
systemctl mask fedora-atomic-desktop-appstream-cache-refresh

# -- Install extest libraries for both architectures --
echo "==> Installing extest libraries..."
mkdir -p /usr/lib/extest /usr/lib64/extest

EXTEST_RELEASE=$(/ctx/ghcurl https://api.github.com/repos/ublue-os/extest/releases/latest)
for asset in libextest.so libextest64.so; do
    url=$(jq -r --arg name "${asset}" \
        '.assets[] | select(.name == $name).browser_download_url' <<< "${EXTEST_RELEASE}")
    if [[ "${asset}" == "libextest64.so" ]]; then
        destination=/usr/lib64/extest/libextest.so
    else
        destination=/usr/lib/extest/libextest.so
    fi
    /ctx/ghcurl "${url}" -Lo "${destination}"
done
unset -v EXTEST_RELEASE asset url destination

# -- Install Sunshine postinst script --
# Download and make executable the Sunshine post-installation script.
echo "==> Installing Sunshine postinst script..."
/ctx/ghcurl \
    "https://github.com/ykshek/Sunshine/raw/1347f9ef290c089b815cf186f7d361470bdb9ef7/src_assets/linux/misc/postinst" \
    -Lo /usr/libexec/sunshine-postinst

chmod +x /usr/libexec/sunshine-postinst

# -- Create autostart directory --
echo "==> Creating autostart directory..."
mkdir -p /etc/xdg/autostart

# -- Apply system patches --
# Patch waydroid-network script and btrfs-assistant-launcher for compatibility.
echo "==> Applying system patches..."
sed -i~ -E \
    's/=.\$\(command -v (nft|ip6?tables-legacy).*/=/g' \
    /usr/lib/waydroid/data/scripts/waydroid-net.sh

# Match the literal runtime variable in the launcher.
# shellcheck disable=SC2016
sed -i \
    's/ --xdg-runtime=\\"${XDG_RUNTIME_DIR}\\"//g' \
    /usr/bin/btrfs-assistant-launcher
