#!/usr/bin/env bash
#
# Install ublue-os-media-automount-udev to automatically mount
# non-removable device partitions under /media/media-automount/.
#
set -euo pipefail

echo "::group::Install ublue-os-media-automount-udev"
trap 'echo "::endgroup::"' EXIT

# -- 1. Install media automount udev rules --
# Install the package from the ublue-os packages Copr repository.
echo "==> Installing ublue-os-media-automount-udev..."
dnf5 install -y \
    --enable-repo=copr:copr.fedorainfracloud.org:ublue-os:packages \
    ublue-os-media-automount-udev

# -- 2. Enable the automount service --
# Enable the service, ignoring errors if it is already enabled.
echo "==> Enabling automount service..."
systemctl enable ublue-os-media-automount.service || true
