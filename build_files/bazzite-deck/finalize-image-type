#!/usr/bin/env bash
#
# Cleanup and finalize the Bazzite image.
#
# Configures desktop autostart, Waydroid integration, steamos-manager,
# systemd services, and COPR repos before running final image steps.
#
set -euo pipefail

echo "::group::Finalize bazzite-deck image"
trap 'echo "::endgroup::"' EXIT

# -- Configure desktop autostart --
# Move Steam autostart entry to the system-wide autostart directory.
echo "==> Configuring desktop autostart..."
mkdir -p "/etc/xdg/autostart"
mv "/etc/skel/.config/autostart/steam.desktop" "/etc/xdg/autostart/steam.desktop"

# -- Configure Waydroid desktop entry --
# Update Waydroid launch command and add Steam library metadata.
echo "==> Configuring Waydroid desktop entry..."
sed -i \
    's@Exec=waydroid first-launch@Exec=/usr/bin/waydroid-launcher first-launch\nX-Steam-Library-Capsule=/usr/share/applications/Waydroid/capsule.png\nX-Steam-Library-Hero=/usr/share/applications/Waydroid/hero.png\nX-Steam-Library-Logo=/usr/share/applications/Waydroid/logo.png\nX-Steam-Library-StoreCapsule=/usr/share/applications/Waydroid/store-logo.png\nX-Steam-Controller-Template=Desktop@g' \
    /usr/share/applications/Waydroid.desktop

# -- Configure steamos-manager platform.toml --
# Update library paths and set the desktop session based on the target image.
echo "==> Configuring steamos-manager platform.toml..."
sed -i \
    's|/usr/lib/|/usr/libexec/|g' \
    /usr/share/steamos-manager/platform.toml

if [[ "${BASE_IMAGE_NAME}" == "kinoite" ]]; then
    sed -i \
        's|Exec=.*|Exec=/usr/bin/return-to-gamemode|' \
        /etc/skel/Desktop/Return.desktop
    printf "\n[session]\ndesktop = \"plasma.desktop\"\n" >> /usr/share/steamos-manager/platform.toml
else
    printf "\n[session]\ndesktop = \"gnome.desktop\"\n" >> /usr/share/steamos-manager/platform.toml
fi

printf "[scx]\nscx_service = \"scx_loader.service\"\n" >> /usr/share/steamos-manager/platform.toml

# -- Hide input-remapper desktop entries --
# Prevent input-remapper GUI and autoload from appearing in desktop menus.
echo "==> Hiding input-remapper desktop entries..."
sed -i \
    's@\[Desktop Entry\]@\[Desktop Entry\]\nNoDisplay=true@g' \
    /usr/share/applications/input-remapper-gtk.desktop
sed -i \
    's@\[Desktop Entry\]@\[Desktop Entry\]\nHidden=true@g' \
    /etc/xdg/autostart/input-remapper-autoload.desktop

# -- Disable COPR repos --
# Disable the COPR repositories after installation is complete.
echo "==> Disabling COPR repos..."
for copr in \
    ublue-os/staging \
    ublue-os/packages \
    ublue-os/bazzite \
    ublue-os/bazzite-multilib \
    ycollet/audinux; do
    dnf5 -y copr disable -y "${copr}"
done

# -- Remove redundant desktop entries --
# Clean up the bazzite-steam-bpm desktop entry if it exists.
echo "==> Removing redundant desktop entries..."
if [[ -f "/usr/share/applications/bazzite-steam-bpm.desktop" ]]; then
    rm -v /usr/share/applications/bazzite-steam-bpm.desktop
fi

# -- Configure gamemode-news-hook --
# Set the announcements JSON URL based on the image branch.
echo "==> Configuring gamemode-news-hook..."
news_branch="${IMAGE_BRANCH}"
case "${news_branch}" in
    testing|unstable) ;;
    *) news_branch="stable" ;;
esac

sed -i \
    "s|^github = .*|github = https://raw.githubusercontent.com/ublue-os/bazzite-gamemode-news/refs/heads/${news_branch}/announcements.json|" \
    /etc/gamemode-news-hook.conf

# -- Configure systemd services --
# Set up symlinks, modify service files, and enable/disable services as needed.
echo "==> Configuring systemd services..."
mkdir -p /usr/lib/systemd/user/gamescope-session-plus@ogui-steam.service.wants
ln -s /usr/lib/systemd/user/steamos-powerbuttond.service \
    /usr/lib/systemd/user/gamescope-session-plus@ogui-steam.service.wants/

sed -i \
    's/@steam/@ogui-steam/g' \
    /usr/lib/systemd/user/gamemode-news-hook.service

sed -i \
    '/^\[Service\]$/a KillSignal=SIGKILL\nTimeoutStopSec=2s\nTimeoutStopFailureMode=kill' \
    /usr/lib/systemd/user/gamemode-news-hook.service

systemctl enable --global steamos-manager.service
systemctl enable --global steamos-manager-session-cleanup.service
systemctl enable --global steamos-manager-configure-cecd.service
systemctl enable steamos-manager.service
systemctl enable inputplumber.service
systemctl enable bazzite-autologin.service
systemctl enable wireplumber-workaround.service
systemctl enable wireplumber-sysconf.service
systemctl enable pipewire-workaround.service
systemctl enable pipewire-sysconf.service
systemctl --global enable gamemode-news-hook.service
systemctl --global disable sdgyrodsu.service
systemctl --global enable steamos-powerbuttond.service
systemctl disable powerstation.service
systemctl disable input-remapper.service
systemctl disable uupd.timer
systemctl disable jupiter-fan-control.service
systemctl disable vpower.service
systemctl disable jupiter-biosupdate.service
systemctl disable jupiter-controller-update.service
systemctl disable acpid.service

# -- Clean up ACPI events --
# Remove all ACPI event configuration files.
echo "==> Cleaning up ACPI events..."
find /etc/acpi/events -mindepth 1 -delete


# -- Re-enable skip_if_unavailable --
# Restore the default DNF behavior after all NVIDIA configuration is complete.
echo "==> Re-enabling skip_if_unavailable..."
dnf5 config-manager setopt skip_if_unavailable=1
