#!/usr/bin/env bash
#
# Install the Steam Deck-patched UPower and lock its version.
#
# Replaces the default upower with the Bazzite-modified version and
# versionlocks both upower and upower-libs to prevent unintended updates.
#
set -euo pipefail

echo "::group::Install patched UPower"
trap 'echo "::endgroup::"' EXIT

# -- Swap to Steam Deck-patched UPower --
# Replace the default upower with the Bazzite-modified version from the COPR repo.
echo "==> Installing Steam Deck-patched UPower..."
dnf5 -y swap \
    --repo copr:copr.fedorainfracloud.org:ublue-os:bazzite \
    upower upower

# -- Versionlock UPower packages --
# Prevent package manager from updating upower and upower-libs beyond the patched version.
echo "==> Versionlocking UPower packages..."
dnf5 versionlock add \
    upower \
    upower-libs
