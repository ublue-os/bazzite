[Unit]
Description=NTFS/exFAT Monitor notification service
ConditionUser=!@system
ConditionEnvironment=XDG_SESSION_CLASS=user
PartOf=xdg-desktop-autostart.target
After=xdg-desktop-autostart.target

[Service]
Type=simple
ExecStart=/usr/libexec/ntfs-exfat-monitor-script

[Install]
WantedBy=xdg-desktop-autostart.target
