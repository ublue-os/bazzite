#!/usr/bin/env sh

. "${MOTD_ENV_SCRIPT:-/usr/share/ublue-os/motd/env.sh}"
MOTD_TEMPLATE_FILE="${MOTD_TEMPLATE_FILE:-/usr/share/ublue-os/motd/template.md}"

MOTD_THEME="${MOTD_FORCE_THEME:-$(gsettings get org.gnome.desktop.interface accent-color 2>/dev/null | tr -d "'")}"
MOTD_THEME_FILE="/usr/share/ublue-os/motd/themes/${MOTD_THEME:-purple}.json"
if [ ! -f "${MOTD_THEME_FILE}" ]; then
  MOTD_THEME_FILE="/usr/share/ublue-os/motd/themes/purple.json"
fi

if command -v tput >/dev/null 2>&1 && [ -t 1 ]; then
  cols=$(tput cols 2>/dev/null)
  envsubst < "${MOTD_TEMPLATE_FILE}" | glow -s "${MOTD_THEME_FILE}" -w $cols -
else
  envsubst < "${MOTD_TEMPLATE_FILE}" | glow -s "${MOTD_THEME_FILE}" -
fi
