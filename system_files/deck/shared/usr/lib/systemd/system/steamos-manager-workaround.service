[Unit]
Description=Workaround steamos-manager needing to write into /usr/lib/sddm/sddm.conf.d/
ConditionPathExists=/usr/lib/sddm/sddm.conf.d
After=local-fs.target

[Service]
Type=oneshot
# Copy if it doesn't exist
ExecStartPre=/usr/bin/bash -c "[ -d /usr/local/share/.sddm ] || /usr/bin/cp -r /usr/lib/sddm/sddm.conf.d/ /usr/local/share/.sddm"
ExecStart=/usr/bin/mount --bind /usr/local/share/.sddm /usr/lib/sddm/sddm.conf.d/
# Clean-up after ourselves
ExecStop=/usr/bin/umount /usr/lib/sddm/sddm.conf.d/
ExecStop=/usr/bin/rm -r /usr/local/share/.sddm
RemainAfterExit=yes
Before=steamos-manager.service

[Install]
WantedBy=multi-user.target
