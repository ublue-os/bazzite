# Backport from systemd's 60-keyboard.hwdb (39c2bf5fa349).
# Remove once Fedora ships both entries.

# OneXPlayer 3
evdev:atkbd:dmi:bvn*:bvr*:bd*:svnONE-NETBOOK*:pnONEXPLAYER3:pvr*
 KEYBOARD_KEY_ae=!volumedown
 KEYBOARD_KEY_b0=!volumeup

# OneXPlayer X2 Mini (G3E)
evdev:atkbd:dmi:bvn*:bvr*:bd*:svnONE-NETBOOK*:pnONEXPLAYERX2Mini:pvr*
 KEYBOARD_KEY_ae=!volumedown
 KEYBOARD_KEY_b0=!volumeup
