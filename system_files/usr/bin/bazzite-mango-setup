#!/bin/bash
# bazzite-mango-setup — what `ujust mango-setup` runs. The user-side half of
# mangowc-setup's install.sh: the image already has the packages, fonts and
# themes, so this only puts the dotfiles in place for the current user.

set -euo pipefail

DATA=/usr/share/bazzite-mango
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/mango"

msg()  { printf '\033[0;32m%s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m%s\033[0m\n' "$*" >&2; }

if [ -d "$CONFIG_DIR" ]; then
    read -rp "Found existing Mango config. Back it up and replace it? (y/n) " -n 1
    echo
    [[ $REPLY =~ ^[Yy]$ ]] || { warn "Cancelled, nothing changed."; exit 1; }
    mv "$CONFIG_DIR" "$CONFIG_DIR.bak.$(date +%s)"
    msg "Backed up existing config"
fi

msg "Copying dotfiles to $CONFIG_DIR ..."
mkdir -p "$CONFIG_DIR"
cp -r "$DATA"/config/. "$CONFIG_DIR"/
cp -r "$DATA"/wallpaper "$DATA"/omarchy-themes "$CONFIG_DIR"/
chmod +x "$CONFIG_DIR"/scripts/*

if systemd-detect-virt -q 2>/dev/null; then
    msg "Virtual machine detected ($(systemd-detect-virt)) - enabling software cursor"
    sed -i 's|^#WLR_NO_HARDWARE_CURSORS=1$|WLR_NO_HARDWARE_CURSORS=1|' "$CONFIG_DIR/env"
fi

# wallpaper-theme recolours a per-user copy of this GTK theme
mkdir -p "$HOME/.themes"
[ -d "$HOME/.themes/Orchis-Dark-Nord" ] || cp -r /usr/share/themes/Orchis-Dark-Nord "$HOME/.themes/"

mkdir -p "$HOME/.config/dunst"
ln -sfn "$CONFIG_DIR/dunst/dunstrc" "$HOME/.config/dunst/dunstrc"

xdg-user-dirs-update 2>/dev/null || true
mkdir -p "$HOME/Screenshots"

msg "Done. Log out and pick 'Mango' at the login screen (KDE Plasma is still there)."
echo "  Super + /        keybindings"
echo "  Super + Space    launcher"
echo "  Super + Shift+p  wallpaper picker (re-themes the desktop)"
echo "Optional: 'ujust mango-apps' installs the Flatpaks the keybindings launch."
